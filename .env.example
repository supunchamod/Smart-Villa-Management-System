APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# WhatsApp (WAHA - WhatsApp HTTP API)
# --------------------------------------------------------------------------
# Connection details for the self-hosted WAHA instance this app talks to
# for WhatsApp messaging (see config/waha.php and app/Services/WhatsAppService.php).

WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_TIMEOUT=30
# Country code (digits only) given to local-format numbers like 077 123 4567.
# Numbers entered as +44 ... or 0044 ... keep their own country code.
WAHA_DEFAULT_COUNTRY_CODE=94

# Master switch for every *automated* WhatsApp trigger (booking
# confirmations, check-in reminders, checkout invoices, post-checkout
# review requests, owner enquiry alerts). Defaults to false so a local
# environment without a running/reachable WAHA instance never fails a
# booking operation just because it tried to send a WhatsApp message.
# The manual "Resend via WhatsApp" button and the WhatsApp settings/QR
# page are unaffected by this flag either way. Set to true only once WAHA
# is actually configured and reachable from this environment.
WHATSAPP_AUTO_SEND=false

# Temporarily hidden admin UI entry points for the Landing Page / public booking site
# (routes keep working; set to true to show the links again).
FEATURE_LANDING_PAGE_UI=false
